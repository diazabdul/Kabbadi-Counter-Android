        {
          "name": "Reset Match",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/match/{{match_id}}/reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "match",
                "{{match_id}}",
                "reset"
              ]
            }
          }
        }
